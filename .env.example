# Local Docker gateway
NEXT_PUBLIC_API_URL=http://localhost:8081/api/access-service
NEXT_PUBLIC_PROPERTY_API_URL=http://localhost:8081/api/property-service

# World Labs Marble World API (https://docs.worldlabs.ai/api)
# Server-side only — never prefix with NEXT_PUBLIC_/VITE_, never read from
# client code. Leave unset to run the 3D tour feature in mock/demo mode
# (no real World Labs calls, no cost).
WORLD_LABS_API_KEY=

# Persistent storage for generated tour assets (splats/panoramas/thumbnails
# /collider meshes) — see src/lib/tours/assetStorage/. Leave unset to fall
# back to a local-filesystem dev cache (NOT durable in production/serverless
# — see assetStorage/localFs.ts). Set this to switch to real, permanent
# Vercel Blob storage: add a Blob store to this project in the Vercel
# dashboard (Storage tab), then `vercel env pull` to get this value locally,
# or set it manually for other hosts that speak the same API.
BLOB_READ_WRITE_TOKEN=

# Optional: Google Gemini API key for enhanced AI property search
# Get yours at https://aistudio.google.com/
# Leave unset to use the built-in rule-based parser (no API cost, works offline).
GEMINI_API_KEY=
